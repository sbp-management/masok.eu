---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Icon from "../components/Icon.astro";
import CourseCards from "../components/CourseCards.astro";
import NewsCard from "../components/NewsCard.astro";
import { t, url, fill, type Lang, type PageKey } from "../i18n";
import { getNews } from "../lib/news";
import { site } from "../data/site";

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const H = d.home;
const news = (await getNews(lang)).slice(0, 8);

const orgLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: "MASOK Academy",
  alternateName: "Akademija MASOK",
  url: site.url,
  logo: `${site.url}/favicon.png`,
  email: site.email,
  telephone: site.phone.replace(/\s/g, ""),
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: site.address.countryCode,
  },
  sameAs: [site.social.facebook, site.social.linkedin],
  parentOrganization: { "@type": "Organization", name: "SBP Management", url: site.sbpManagement },
};
const websiteLd = { "@context": "https://schema.org", "@type": "WebSite", name: d.siteName, url: site.url, inLanguage: ["sr", "en"] };
---

<Base lang={lang} page="home" title={d.meta.home.title} description={d.meta.home.description} jsonLd={[orgLd, websiteLd]}>
  <section class="hero">
    <Photo name="hero-instruments" alt="" class="hero-bg" sizes="100vw" widths={[640, 1024, 1600, 2200]} priority />
    <div class="container">
      <h1>{H.title}</h1>
      <p class="hero-sub">{H.subtitle}</p>
      {H.lines.map((l) => <p class="hero-line">{l}</p>)}
      <div class="btn-row">
        <a class="btn btn-white" href={url(lang, H.primaryButton.page as PageKey)}>{H.primaryButton.label}</a>
        <a class="btn btn-navy" href={url(lang, H.secondaryButton.page as PageKey)}>{H.secondaryButton.label}</a>
      </div>
    </div>
  </section>

  <section class="section bg-soft">
    <div class="container">
      <h2 class="section-title">{H.whyTitle}</h2>
      <ul class="grid grid-6" role="list" style="list-style:none;padding:0;margin:0">
        {H.why.map((w) => (
          <li class="card why-card">
            <div class="icon-box icon-yellow"><Icon name={w.icon} /></div>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">{H.coursesTitle}</h2>
      <CourseCards lang={lang} />
    </div>
  </section>

  <section class="section bg-yellow highlight">
    <div class="container">
      <h2>{H.highlightTitle}</h2>
      <p>{fill(H.highlightText, lang)}</p>
      <a class="btn btn-navy" href={url(lang, "applicants")}>{H.highlightButton}</a>
    </div>
  </section>

  {
    news.length > 0 && (
      <section class="section bg-soft">
        <div class="container">
          <h2 class="section-title">{H.newsTitle}</h2>
          <div class="news-scroller">
            <div class="news-track" role="region" aria-label={H.newsTitle} tabindex="0">
              {news.map((a) => <NewsCard article={a} />)}
            </div>
            <button class="scroll-btn prev" type="button" aria-label={H.newsPrev} hidden><Icon name="chevron" /></button>
            <button class="scroll-btn next" type="button" aria-label={H.newsNext} hidden><Icon name="chevron" /></button>
          </div>
          <p class="center" style="margin-top:32px"><a class="btn btn-navy" href={url(lang, "news")}>{H.allNews}</a></p>
        </div>
      </section>
    )
  }
</Base>

<script>
  // Latest news: prev/next buttons for the horizontal card strip
  document.querySelectorAll<HTMLElement>(".news-scroller").forEach((box) => {
    const track = box.querySelector<HTMLElement>(".news-track")!;
    const prev = box.querySelector<HTMLButtonElement>(".scroll-btn.prev")!;
    const next = box.querySelector<HTMLButtonElement>(".scroll-btn.next")!;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.hidden = next.hidden = max <= 1;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
      box.classList.toggle("more-left", !prev.disabled && max > 1);
      box.classList.toggle("more-right", !next.disabled && max > 1);
    };
    const step = (dir: number) => {
      const card = track.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      track.scrollBy({ left: dir * ((card?.offsetWidth ?? track.clientWidth) + gap) });
    };
    prev.addEventListener("click", () => step(-1));
    next.addEventListener("click", () => step(1));
    track.addEventListener("scroll", update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  });
</script>
