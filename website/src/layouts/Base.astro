---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
import "../styles/global.css";
import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { t, alternates, type Lang, type PageKey } from "../i18n";
import { defaultLang } from "../i18n/routes";
import { findImage } from "../data/images";
import { site } from "../data/site";

interface Props {
  lang: Lang;
  /** Which page this is (for the menu, language switch and hreflang). */
  page?: PageKey;
  title: string;
  description: string;
  /** Override language versions, e.g. for a news article. */
  langLinks?: { lang: Lang; href: string }[];
  /** Image key from src/data/images.ts used for social-media previews. */
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  /** Structured data (schema.org) objects for Google. */
  jsonLd?: object[];
}

const { lang, page, title, description, ogImage = "hero-instruments", ogType = "website", noindex = false, jsonLd = [] } = Astro.props;
const d = t(lang);
const langLinks = Astro.props.langLinks ?? (page ? alternates(page) : []);

const canonical = new URL(Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/"), site.url).href;

// Social preview image (1200×630), generated from a site photo
let ogImageUrl: string | undefined;
const ogMeta = findImage(ogImage) ?? findImage("hero-instruments");
if (ogMeta) {
  const og = await getImage({ src: ogMeta, width: 1200, height: 630, fit: "cover", format: "jpg" });
  ogImageUrl = new URL(og.src, site.url).href;
}
const favicon = "/favicon.png";
---

<!doctype html>
<html lang={d.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      !noindex && langLinks.length > 1 && (
        <>
          {langLinks.map((l) => <link rel="alternate" hreflang={t(l.lang).htmlLang} href={new URL(l.href, site.url).href} />)}
          <link rel="alternate" hreflang="x-default" href={new URL((langLinks.find((l) => l.lang === defaultLang) ?? langLinks[0]).href, site.url).href} />
        </>
      )
    }
    <link rel="icon" type="image/png" href={favicon} />
    <link rel="apple-touch-icon" href={favicon} />
    <meta name="theme-color" content="#283464" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={d.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={d.ogLocale} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{d.ui.skip}</a>
    <Header lang={lang} page={page} langLinks={langLinks} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <button class="to-top" type="button" aria-label={d.ui.toTop}><Icon name="up" /></button>

    <script>
      // Back-to-top button
      const toTop = document.querySelector<HTMLButtonElement>(".to-top");
      if (toTop) {
        const onScroll = () => toTop.classList.toggle("show", window.scrollY > 500);
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
        toTop.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
          document.querySelector<HTMLElement>(".skip-link")?.focus({ preventScroll: true });
        });
      }

      // Gentle fade-in of cards while scrolling
      if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("js-reveal");
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }),
          { rootMargin: "0px 0px -40px 0px" },
        );
        document.querySelectorAll(".card, .package, .service, .section-title").forEach((el) => {
          if (el.getBoundingClientRect().top > window.innerHeight) { el.classList.add("reveal"); io.observe(el); }
        });
      }
    </script>
  </body>
</html>
