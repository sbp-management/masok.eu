---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import Icon from "../components/Icon.astro";
import CourseCards from "../components/CourseCards.astro";
import NewsCard from "../components/NewsCard.astro";
import Words from "../components/Words.astro";
import Advert from "../components/Advert.astro";
import { t, url, fill, type Lang, type PageKey } from "../i18n";
import { getNews } from "../lib/news";
import { site } from "../data/site";
import { courseKeys } from "../i18n/routes";

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const H = d.home;
const news = (await getNews(lang)).slice(0, 8);
// Photos that take turns behind the hero, mostly school-related. The first one loads with the page;
// the rest follow in this order. Choices come from src/assets/images/hero-candidates/.
const heroFirst = "school-books";
const heroSlides = ["school-lab", "hero-instruments", "german-course"];
const courseNames = courseKeys.map((k) => d.courses[k].title);

const orgLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  name: "MASOK Academy",
  alternateName: "Akademija MASOK",
  url: site.url,
  logo: `${site.url}/favicon.png`,
  email: site.email,
  telephone: site.phone.replace(/\s/g, ""),
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: site.address.countryCode,
  },
  sameAs: [site.social.facebook, site.social.linkedin],
  parentOrganization: { "@type": "Organization", name: "SBP Management", url: site.sbpManagement },
};
const websiteLd = { "@context": "https://schema.org", "@type": "WebSite", name: d.siteName, url: site.url, inLanguage: ["sr", "en"] };
---

<Base lang={lang} page="home" title={d.meta.home.title} description={d.meta.home.description} jsonLd={[orgLd, websiteLd]}>
  <section class="hero">
    <Photo name={heroFirst} alt="" class="hero-bg hero-slide is-first" sizes="100vw" widths={[640, 1024, 1600, 2200]} priority />
    {heroSlides.map((name) => (
      <template class="hero-slide-tpl">
        <Photo name={name} alt="" class="hero-bg hero-slide" sizes="100vw" widths={[640, 1024, 1600, 2200]} />
      </template>
    ))}
    <div class="container">
      <h1><Words text={H.title} /></h1>
      <p class="hero-sub hero-in" style="--d:450ms">{H.subtitle}</p>
      {H.lines.map((l, i) => <p class="hero-line hero-in" style={`--d:${600 + i * 120}ms`}>{l}</p>)}
      <div class="btn-row hero-in" style="--d:900ms">
        <a class="btn btn-white" href={url(lang, H.primaryButton.page as PageKey)}>{H.primaryButton.label}</a>
        <a class="btn btn-navy" href={url(lang, H.secondaryButton.page as PageKey)}>{H.secondaryButton.label}</a>
      </div>
      <Advert lang={lang} />
    </div>
  </section>

  <div class="ticker">
    <div class="ticker-track">
      {[false, true].map((copy) => (
        <ul aria-hidden={copy ? "true" : undefined}>
          {[...courseNames, ...courseNames].map((n, i) => <li aria-hidden={i >= courseNames.length ? "true" : undefined}>{n}</li>)}
        </ul>
      ))}
    </div>
  </div>

  <section class="section bg-soft">
    <div class="container">
      <h2 class="section-title">{H.whyTitle}</h2>
      <ul class="grid grid-6" role="list" style="list-style:none;padding:0;margin:0">
        {H.why.map((w) => (
          <li class="card why-card">
            <div class="icon-box icon-yellow"><Icon name={w.icon} /></div>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">{H.coursesTitle}</h2>
      <CourseCards lang={lang} />
    </div>
  </section>

  <section class="section bg-yellow highlight">
    <span class="drift" aria-hidden="true" style="--s:56px;top:14%;left:6%;--dy:-28px;--dr:12deg"></span>
    <span class="drift" aria-hidden="true" style="--s:28px;top:62%;left:14%;--c:var(--white);--o:.35;--dx:18px;--dr:-10deg;--d:-3s"></span>
    <span class="drift" aria-hidden="true" style="--s:40px;top:20%;right:9%;--c:var(--white);--o:.3;--dy:26px;--d:-5s"></span>
    <span class="drift" aria-hidden="true" style="--s:72px;bottom:-18px;right:18%;--dx:-20px;--dr:-8deg;--d:-1.5s"></span>
    <div class="container">
      <h2>{H.highlightTitle}</h2>
      <p>{fill(H.highlightText, lang)}</p>
      <a class="btn btn-navy" href={url(lang, "applicants")}>{H.highlightButton}</a>
    </div>
  </section>

  {
    news.length > 0 && (
      <section class="section bg-soft">
        <div class="container">
          <h2 class="section-title">{H.newsTitle}</h2>
          <div class="news-scroller">
            <div class="news-track" role="region" aria-label={H.newsTitle} tabindex="0">
              {news.map((a) => <NewsCard article={a} />)}
            </div>
            <button class="scroll-btn prev" type="button" aria-label={H.newsPrev} hidden><Icon name="chevron" /></button>
            <button class="scroll-btn next" type="button" aria-label={H.newsNext} hidden><Icon name="chevron" /></button>
          </div>
          <Advert lang={lang} placement="news" />
          <p class="center" style="margin-top:32px"><a class="btn btn-navy" href={url(lang, "news")}>{H.allNews}</a></p>
        </div>
      </section>
    )
  }
</Base>

<script>
  // Hero slideshow: every 9 s the next photo slides in while the current one fades out.
  // The other photos wait in <template>s and are only added (and downloaded) shortly before their turn.
  const hero = document.querySelector<HTMLElement>(".hero");
  const templates = [...document.querySelectorAll<HTMLTemplateElement>(".hero-slide-tpl")];
  if (hero && templates.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const HOLD = 9000;
    const slides: (HTMLElement | null)[] = [hero.querySelector<HTMLElement>(".hero-slide.is-first"), ...templates.map(() => null)];
    const slideAt = (i: number) => {
      if (!slides[i]) {
        const node = templates[i - 1].content.firstElementChild!.cloneNode(true) as HTMLElement;
        templates[i - 1].replaceWith(node);
        slides[i] = node.querySelector<HTMLElement>(".hero-slide") ?? node;
      }
      return slides[i]!;
    };
    let current = 0;
    setTimeout(() => slideAt(1), HOLD - 4000);
    setInterval(() => {
      const next = (current + 1) % slides.length;
      slides.forEach((s) => s?.classList.remove("is-first", "is-in", "is-out"));
      slideAt(current).classList.add("is-out");
      slideAt(next).classList.add("is-in");
      current = next;
      setTimeout(() => slideAt((current + 1) % slides.length), HOLD - 4000);
    }, HOLD);
  }

  // Latest news: prev/next buttons for the horizontal card strip
  document.querySelectorAll<HTMLElement>(".news-scroller").forEach((box) => {
    const track = box.querySelector<HTMLElement>(".news-track")!;
    const prev = box.querySelector<HTMLButtonElement>(".scroll-btn.prev")!;
    const next = box.querySelector<HTMLButtonElement>(".scroll-btn.next")!;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.hidden = next.hidden = max <= 1;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
      box.classList.toggle("more-left", !prev.disabled && max > 1);
      box.classList.toggle("more-right", !next.disabled && max > 1);
    };
    const step = (dir: number) => {
      const card = track.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      track.scrollBy({ left: dir * ((card?.offsetWidth ?? track.clientWidth) + gap) });
    };
    prev.addEventListener("click", () => step(-1));
    next.addEventListener("click", () => step(1));
    track.addEventListener("scroll", update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  });
</script>
