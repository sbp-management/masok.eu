---
import Photo from "./Photo.astro";
import { t, url, type Lang } from "../i18n";
import { courseKeys, type CourseKey } from "../i18n/routes";

interface Props { lang: Lang; headingLevel?: "h2" | "h3" }
const { lang, headingLevel = "h3" } = Astro.props;
const d = t(lang);
const H = headingLevel;

// Photo at the top of each card (names from src/data/images.ts).
// `fit: true` shows the whole image (no cropping) on its own background colour – used for the wide flags picture.
const cardPhotos: Record<CourseKey, { name: string; fit?: boolean; bg?: string }> = {
  mechanic: { name: "card-mechanic" },
  assistant: { name: "card-mfa" },
  technician: { name: "card-sterilization" },
  german: { name: "card-languages", fit: true, bg: "#ebecee" },
};
---

<div class="grid grid-4">
  {
    courseKeys.map((key) => {
      const c = d.courseCards[key];
      return (
        <article class="card course-card">
          <div class:list={["course-photo", { fit: cardPhotos[key].fit }]} style={cardPhotos[key].bg ? `background:${cardPhotos[key].bg}` : undefined}>
            <Photo name={cardPhotos[key].name} alt="" class="media" sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 280px" widths={[320, 560, 700]} />
          </div>
          <div class="course-body">
            <H>{c.title}</H>
            <p>{c.text}</p>
            <a class="btn btn-navy btn-sm" href={url(lang, key)} aria-label={`${d.ui.viewCourse}: ${c.title}`}>{d.ui.viewCourse}</a>
          </div>
        </article>
      );
    })
  }
</div>

<style>
  .course-card { padding: 0; overflow: hidden; }
  .course-photo { width: 100%; aspect-ratio: 3 / 2; overflow: hidden; }
  /* Hover: the photo zooms in */
  .course-photo :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: 0; transition: transform .6s ease; }
  .course-card:is(:hover, :focus-within) .course-photo :global(img) { transform: scale(1.12); }
  .course-photo.fit :global(img) { object-fit: contain; }
  .course-body { display: flex; flex-direction: column; align-items: center; flex: 1; padding: 4px 22px 26px; }
  @media (prefers-reduced-motion: reduce) {
    .course-photo :global(img), .course-card:is(:hover, :focus-within) .course-photo :global(img) { transition: none; transform: none; }
  }
</style>
