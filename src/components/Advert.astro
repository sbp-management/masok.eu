---
/**
 * Open-day advert under the homepage hero buttons (rebuilt from the old one.com banner).
 * Drawn on a 1414 × 316 grid; every size is in cqw so the whole banner scales with its width.
 * Attention: it rises in quickly after the hero buttons, then every 6 s it pops (grows 6% and back
 * in 0.24 s), a gold sheen sweeps across it,
 * the arrow nudges towards the QR code and a gold ring pulses from the QR frame.
 * All motion is off for visitors who ask for reduced motion.
 * Narrower than 900 px (phones, tablets in portrait), it switches to a stacked layout with readable text and a large button.
 * Used twice on the homepage: under the hero buttons and above "All news" (placement="news", centred).
 */
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/800.css";
import { t, type Lang } from "../i18n";
import { site } from "../data/site";

interface Props { lang: Lang; placement?: "hero" | "news" }
const { lang, placement = "hero" } = Astro.props;
const A = t(lang).home.advert;
const a = site.address;
---

<div class:list={["advert-wrap", `advert-${placement}`]}>
  <aside class="advert" aria-label={A.headline}>
    <span class="ad-shine" aria-hidden="true"></span>
    <div class="ad-bracket" aria-hidden="true"></div>
    <svg class="ad-chevron" viewBox="0 0 24 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l16 20L4 44"/></svg>

    <div class="ad-text">
      <p class="ad-headline">{A.headline}</p>
      <p class="ad-lines">{A.lines[0]}<br />{A.lines[1]}</p>
    </div>

    <p class="ad-address"><strong>{A.name}</strong> {a.street}, {a.city}</p>
    <p class="ad-web">www.masok.eu</p>

    <svg class="ad-arrow" viewBox="0 0 190 60" fill="none" aria-hidden="true"><path d="M8 58C20 26 70 6 160 16" stroke="currentColor" stroke-width="4" stroke-linecap="round"/><path d="M150 2l30 15-28 17z" fill="currentColor"/></svg>
    <p class="ad-scan">{A.scan}</p>
    <a class="ad-click" href={site.openDayFormUrl} target="_blank" rel="noopener">{A.click}</a>

    <div class="ad-qr">
      <div><img src="/images/qr-open-day.svg" alt={A.qrAlt} width="200" height="200" loading="lazy" /></div>
    </div>
  </aside>
</div>

<style>
  .advert-wrap {
    --cycle: 6s;
    --start: 1.9s;
    width: 100%; max-width: 1050px; margin-top: 40px; position: relative; z-index: 1;
    container: advert-wrap / inline-size;
    transform-origin: center;
    animation: advert-pop var(--cycle) cubic-bezier(.3, 0, .2, 1) var(--start) infinite;
  }
  .advert-news { margin: 48px auto 0; }
  .advert-news .advert::before { box-shadow: 0 1.2cqw 3cqw rgba(10, 14, 30, .18); }
  .advert {
    --gold: #c8963e;
    --ink: #1e2b4f;
    position: relative; width: 100%; aspect-ratio: 1414 / 316; container-type: inline-size;
    color: var(--ink); line-height: 1.2;
    animation: advert-in .7s cubic-bezier(.2, .8, .2, 1) 1s both;
    transition: transform .25s ease;
  }
  .advert:hover { transform: translateY(-.4cqw); }
  .advert::before {
    content: ""; position: absolute; inset: 2.122cqw 0 0 0; background: #eaf1f1; border-radius: .283cqw;
    box-shadow: 0 1.2cqw 3cqw rgba(10, 14, 30, .35); transition: box-shadow .25s ease;
  }
  .advert:hover::before { box-shadow: 0 1.8cqw 4cqw rgba(10, 14, 30, .45); }

  /* Light sweep across the panel */
  .ad-shine { inset: 2.122cqw 0 0 0; overflow: hidden; border-radius: .283cqw; pointer-events: none; z-index: 1; }
  .ad-shine::after {
    content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 22%;
    background: linear-gradient(100deg, transparent, rgba(232, 193, 66, .38) 50%, transparent);
    translate: -120% 0; transform: skewX(-18deg);
    animation: advert-shine var(--cycle) ease-in-out var(--start) infinite;
  }
  .ad-arrow { animation: advert-nudge var(--cycle) ease-in-out var(--start) infinite; }
  .ad-qr::after {
    content: ""; position: absolute; inset: -.141cqw; border: .35cqw solid var(--gold); pointer-events: none;
    opacity: 0; animation: advert-ping var(--cycle) ease-out var(--start) infinite;
  }
  .advert > * { position: absolute; margin: 0; }
  .ad-bracket { left: 1.839cqw; top: 3.536cqw; width: 2.192cqw; height: 10.396cqw; border-left: .354cqw solid var(--gold); border-top: .354cqw solid var(--gold); }
  .ad-chevron { left: 3.819cqw; top: 7.496cqw; width: 1.839cqw; height: 3.536cqw; color: var(--gold); }
  .ad-text { left: 7.921cqw; top: 3.536cqw; font-family: "Poppins", sans-serif; font-weight: 800; }
  .ad-headline { margin: 0; font-size: 3.536cqw; line-height: 1.1; color: var(--gold); }
  .ad-lines { margin: .707cqw 0 0; font-size: 1.839cqw; line-height: 1.42; }
  .ad-address { left: 3.678cqw; top: 14.851cqw; font-size: 2.687cqw; white-space: nowrap; }
  .ad-web { left: 3.678cqw; top: 18.812cqw; font-size: 1.202cqw; font-weight: 700; }
  .ad-arrow { left: 64.639cqw; top: .424cqw; width: 13.437cqw; height: 4.243cqw; color: var(--gold); }
  .ad-scan, .ad-click { left: 61.74cqw; width: 15.983cqw; display: flex; align-items: center; justify-content: center; font-family: "Poppins", sans-serif; font-weight: 600; }
  .ad-scan { top: 4.597cqw; height: 3.253cqw; border: .141cqw solid var(--gold); border-radius: .283cqw; font-size: max(1.273cqw, 13px); color: var(--gold); }
  .ad-click {
    top: 8.6cqw; height: max(3.112cqw, 32px); font-size: max(1.202cqw, 13px); color: #fff; background: var(--ink); border-radius: 999px;
    text-decoration: none; z-index: 2; transition: background .2s ease;
  }
  .ad-click:hover { background: var(--gold); color: var(--ink); }
  .ad-qr { left: 79.774cqw; top: 2.97cqw; width: 18.388cqw; height: 18.246cqw; border: .141cqw solid var(--gold); padding: .636cqw; background: #eaf1f1; }
  .ad-qr div { width: 100%; height: 100%; background: #fff; display: grid; place-items: center; }
  .ad-qr img { width: 14.144cqw; height: 14.144cqw; image-rendering: pixelated; }

  /* ---------- Stacked layout for narrow screens ----------
   * Text on top, then the button and "scan and register" on the left with the QR code on the right. */
  @container advert-wrap (max-width: 900px) {
    .advert {
      aspect-ratio: auto; container-type: normal;
      display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 16px; align-items: center;
      padding: 22px 18px 20px 32px;
    }
    .advert::before, .ad-shine { inset: 0; border-radius: 6px; }
    .advert::before { box-shadow: 0 10px 28px rgba(10, 14, 30, .3); }
    .advert-news .advert::before { box-shadow: 0 8px 22px rgba(10, 14, 30, .15); }
    .advert:hover { transform: none; }
    .advert > * { position: relative; inset: auto; }
    /* ".advert > *" outranks a single class once Astro scopes it, so these two repeat the parent */
    .advert > .ad-shine { position: absolute; inset: 0; }
    .advert > .ad-bracket { position: absolute; left: 12px; top: 22px; width: 12px; height: 64px; border-width: 3px; }
    .ad-chevron, .ad-arrow { display: none; }
    .ad-text { grid-column: 1 / -1; }
    .ad-headline { font-size: 30px; }
    .ad-lines { margin-top: 6px; font-size: 15px; line-height: 1.4; }
    .advert > .ad-address { grid-column: 1 / -1; margin-top: 14px; font-size: 17px; white-space: normal; }
    .advert > .ad-web { grid-column: 1 / -1; margin-top: 2px; font-size: 13px; }
    .ad-scan, .ad-click { grid-column: 1; width: auto; }
    .advert > .ad-scan { grid-row: 5; align-self: end; margin-top: 18px; min-height: 40px; padding: 4px 8px; border-width: 2px; border-radius: 4px; font-size: 13px; text-align: center; }
    .advert > .ad-click { grid-row: 6; align-self: start; margin-top: 10px; height: 48px; padding: 0 16px; font-size: 16px; }
    .advert > .ad-qr { grid-column: 2; grid-row: 5 / 7; align-self: end; width: 124px; height: 124px; margin-top: 18px; border-width: 2px; padding: 6px; }
    .ad-qr img { width: 100px; height: 100px; }
    .ad-qr::after { inset: -2px; border-width: 3px; }
  }

  @keyframes advert-in {
    from { opacity: 0; translate: 0 2.5cqw; scale: .96; }
  }
  /* One 6 s cycle: quick pop (0–4%), sweep (0–20%), arrow nudge (18–32%), QR ring (24–50%), then rest. */
  @keyframes advert-pop {
    0%, 4%, 100% { scale: 1; }
    2% { scale: 1.06; }
  }
  @keyframes advert-shine {
    0% { translate: -120% 0; }
    20%, 100% { translate: 560% 0; }
  }
  @keyframes advert-nudge {
    0%, 18%, 32%, 100% { translate: 0 0; }
    25% { translate: .8cqw .25cqw; }
  }
  @keyframes advert-ping {
    0%, 24% { opacity: 0; scale: 1; }
    26% { opacity: 1; scale: 1; }
    52%, 100% { opacity: 0; scale: 1.28; }
  }
  @media (prefers-reduced-motion: reduce) {
    .advert-wrap, .advert, .ad-shine::after, .ad-arrow, .ad-qr::after { animation: none; }
    .advert, .advert::before { transition: none; }
  }
</style>
